# =====================================================================
# AGRI BRIDGE ZERO - ENVIRONMENT CONFIGURATION
# =====================================================================
# Rename this file to .env or .env.local to configure your production keys.
# Free tiers are supported for Resend, Google Gemini, and Groq!

# ---------------------------------------------------------------------
# 1. RESEND (FREE TIER: 100 emails/day, 3,000 emails/month)
# ---------------------------------------------------------------------
# Used for OTP dispatch, farm notifications, and soil report delivery.
# Sign up at: https://resend.com (No credit card required)
# Generate an API key from the Resend Dashboard.
VITE_RESEND_API_KEY=re_demo_resend_api_key_free_tier
VITE_RESEND_FROM_EMAIL=onboarding@resend.dev
VITE_NOTIFICATION_EMAIL=alerts@agribridgezero.com

# ---------------------------------------------------------------------
# 2. FREE LLMS FOR AI ADVISOR & MULTI-AGENT ORCHESTRATION
# ---------------------------------------------------------------------
# AgriBridgeZero includes a built-in fast offline agronomic knowledge
# engine that works without any key. To connect real-time online LLMs:

# Google Gemini (Free tier with generous rate limits, 15 RPM free):
# Get free key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Groq (Ultra-fast Llama-3 / Mixtral inference, completely free tier):
# Get free key at: https://console.groq.com/
VITE_GROQ_API_KEY=

# OpenRouter (Optional free models):
VITE_OPENROUTER_API_KEY=

# Default AI Model to use: 'gemini-2.0-flash' | 'groq-llama-3.3-70b' | 'local-engine'
VITE_DEFAULT_AI_PROVIDER=local-engine

# ---------------------------------------------------------------------
# 3. PHYSICAL DEVICE & IOT GATEWAY CONFIGURATION
# ---------------------------------------------------------------------
# MQTT Broker and WebSocket URL for real-time AgriBridgeZero hardware streaming
VITE_MQTT_BROKER_URL=wss://mqtt.agribridgezero.com:8884
VITE_DEVICE_GATEWAY_URL=https://gateway.agribridgezero.com/api/v1
VITE_DEFAULT_DEVICE_ID=ABZ-001

# ---------------------------------------------------------------------
# 4. GEOSPATIAL & MAP CONFIGURATION
# ---------------------------------------------------------------------
# Cadastral parcel tiles & satellite basemaps (OpenStreetMap / Esri World Imagery)
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_STREET_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------------------------------------------------------------------
# 5. AUTHENTICATION & DEMO MODE
# ---------------------------------------------------------------------
# 'true' enables demo OTP (779580) and simulated fast phone login like Zepto/Blinkit/Rapido
VITE_ENABLE_DEMO_OTP=true
VITE_DEMO_OTP_CODE=779580
